# SupplyShield AI — Environment Configuration (Phase 5: Groq Integration)
# Copy this file to .env to configure local settings.
# NEVER commit your real .env file or API keys to version control.

# Server Configuration
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173

# Groq Cloud Integration (Phase 5)
# Free-only safety control: Set to 'true' ONLY after setting your GROQ_API_KEY.
# Default is 'false' to guarantee zero unintended cloud API usage.
ENABLE_GROQ=false

# Groq API Key from https://console.groq.com/keys
# Kept exclusively on the backend server. Never exposed to browser or frontend bundles.
GROQ_API_KEY=your_groq_api_key_here

# Groq Free Tier Model Identifier
# Recommended Free Tier models:
# - llama-3.3-70b-versatile (Meta Llama 3.3 70B, production reasoning, 128k context) [DEFAULT]
# - llama-3.1-8b-instant (Meta Llama 3.1 8B, high speed, 128k context)
GROQ_MODEL=llama-3.3-70b-versatile

# Official Groq OpenAI-compatible Base URL
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional Server Safety Tuning
REQUEST_TIMEOUT_MS=20000
RATE_LIMIT_MAX_REQUESTS=20
